from pathlib import Path

import numpy as np
from scipy.io import savemat

from puertorico_data import gps_data_path


BIG_JUMP_THRESHOLD_S = 1000.0


def sort_by_tags(tags, utc_time):
    """
    Sort chronologically by:
        1. whole seconds
        2. nanoseconds
    """

    order = np.lexsort(
        (
            tags[:, 1],  # secondary: nanoseconds
            tags[:, 0],  # primary: whole seconds
        )
    )

    return tags[order], utc_time[order]


def save_timetags(output_file, tags, utc_time):
    savemat(
        output_file,
        {
            "tags": tags,
            "utc_time": utc_time,
        },
        do_compression=True,
    )

    print(f"Wrote {output_file}")
    print(f"Rows: {len(tags):,}")


def timetags_to_mat(
    input_files,
    output_file_before,
    output_file_after,
):
    """
    Combine timetag text files, split at the large clock jump,
    sort each clock segment chronologically, and save two MAT files.

    Output variables
    ----------------
    tags : N x 2
        Column 0: whole-second counter
        Column 1: nanoseconds

    utc_time : N x 4
        Column 0: UTC time as HHMMSS.SS
        Column 1: day
        Column 2: month
        Column 3: year
    """

    tags = []
    utc_time = []

    for input_file in input_files:
        with input_file.open("r", encoding="ascii", errors="replace") as file:
            for line_number, raw_line in enumerate(file, 1):
                line = raw_line.strip()

                if not line:
                    continue

                fields = line.split(",")

                if len(fields) < 7:
                    raise ValueError(
                        f"Unexpected row in {input_file}:{line_number}: {line}"
                    )

                whole_seconds = int(fields[0])
                nanoseconds = int(fields[1])

                if fields[2] != "$GPZDA":
                    raise ValueError(
                        f"Unexpected record in "
                        f"{input_file}:{line_number}: {line}"
                    )

                hhmmss = float(fields[3])
                day = int(fields[4])
                month = int(fields[5])
                year = int(fields[6])

                tags.append(
                    [
                        whole_seconds,
                        nanoseconds,
                    ]
                )

                utc_time.append(
                    [
                        hhmmss,
                        day,
                        month,
                        year,
                    ]
                )

    if not tags:
        raise ValueError("No timetag rows were read.")

    tags = np.asarray(tags, dtype=np.int32)
    utc_time = np.asarray(utc_time, dtype=np.float64)

    # ---------------------------------------------------------
    # Find the major backward clock jump in ORIGINAL file order
    # ---------------------------------------------------------

    tag_seconds = (
        tags[:, 0].astype(np.float64)
        + tags[:, 1].astype(np.float64) / 1e9
    )

    jumps = np.diff(tag_seconds)

    big_jumps = np.where(
        jumps < -BIG_JUMP_THRESHOLD_S
    )[0]

    if len(big_jumps) == 0:
        raise ValueError(
            "No large backward timetag jump was found."
        )

    if len(big_jumps) > 1:
        raise ValueError(
            f"Found {len(big_jumps)} large backward timetag jumps."
        )

    jump_index = big_jumps[0]

    print()
    print("Large clock jump found:")
    print(
        f"  {tag_seconds[jump_index]:.9f} -> "
        f"{tag_seconds[jump_index + 1]:.9f} s"
    )
    print(
        f"  jump = {jumps[jump_index]:.9f} s"
    )
    print()

    # The reset occurs BETWEEN jump_index and jump_index + 1.
    tags_before = tags[: jump_index + 1]
    utc_before = utc_time[: jump_index + 1]

    tags_after = tags[jump_index + 1 :]
    utc_after = utc_time[jump_index + 1 :]

    # ---------------------------------------------------------
    # Sort each continuous clock segment independently
    # ---------------------------------------------------------

    tags_before, utc_before = sort_by_tags(
        tags_before,
        utc_before,
    )

    tags_after, utc_after = sort_by_tags(
        tags_after,
        utc_after,
    )

    # ---------------------------------------------------------
    # Save
    # ---------------------------------------------------------

    save_timetags(
        output_file_before,
        tags_before,
        utc_before,
    )

    save_timetags(
        output_file_after,
        tags_after,
        utc_after,
    )


if __name__ == "__main__":
    input_path = gps_data_path("CDOG_Data/Raw/")
    output_path = gps_data_path("CDOG_Data")

    INPUT_FILES = sorted(
        input_path.glob("File*.txt"),
        key=lambda p: int(p.stem.replace("File", "")),
    )

    OUTPUT_FILE_BEFORE = (
        output_path / "DOG1-camp-before-clock-loss.mat"
    )

    OUTPUT_FILE_AFTER = (
        output_path / "DOG1-camp-after-clock-loss.mat"
    )

    timetags_to_mat(
        INPUT_FILES,
        OUTPUT_FILE_BEFORE,
        OUTPUT_FILE_AFTER,
    )