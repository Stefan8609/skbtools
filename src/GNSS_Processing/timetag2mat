from pathlib import Path

import numpy as np
from scipy.io import savemat

from puertorico_data import gps_data_path


def timetags_to_mat(input_files, output_file):
    """
    Combine all timetag text files into one MAT file.

    Output variables
    ----------------
    tags : N x 2
        Column 0: whole-second counter
        Column 1: nanoseconds

    utc_time : N x 4
        Column 0: UTC time as HHMMSS.SS
        Column 1: day
        Column 2: month
        Column 3: year

    Example input row:
        5858,982216300,$GPZDA,234629.00,16,01,2023,+00,00*40

    becomes:
        tags     = [5858, 982216300]
        utc_time = [234629.00, 16, 1, 2023]
    """

    tags = []
    utc_time = []

    for input_file in input_files:
        with input_file.open("r", encoding="ascii", errors="replace") as file:
            for line_number, raw_line in enumerate(file, 1):
                line = raw_line.strip()

                if not line:
                    continue

                fields = line.split(",")

                if len(fields) < 7:
                    raise ValueError(
                        f"Unexpected row in {input_file}:{line_number}: {line}"
                    )

                whole_seconds = int(fields[0])
                nanoseconds = int(fields[1])

                if fields[2] != "$GPZDA":
                    raise ValueError(
                        f"Unexpected record in {input_file}:{line_number}: {line}"
                    )

                hhmmss = float(fields[3])
                day = int(fields[4])
                month = int(fields[5])
                year = int(fields[6])

                tags.append(
                    [
                        whole_seconds,
                        nanoseconds,
                    ]
                )

                utc_time.append(
                    [
                        hhmmss,
                        day,
                        month,
                        year,
                    ]
                )

    if not tags:
        raise ValueError("No timetag rows were read.")

    tags = np.asarray(tags, dtype=np.int32)
    utc_time = np.asarray(utc_time, dtype=np.float64)

    savemat(
        output_file,
        {
            "tags": tags,
            "utc_time": utc_time,
        },
        do_compression=True,
    )

    print(f"Wrote {output_file}")
    print(f"Rows: {len(tags):,}")


if __name__ == "__main__":
    input_path = gps_data_path("CDOG_Data/Raw/")
    output_path = gps_data_path("CDOG_Data")

    INPUT_FILES = sorted(
        input_path.glob("File*.txt"),
        key=lambda p: int(p.stem.replace("File", "")),
    )
    
    OUTPUT_FILE = output_path / "DOG1-camp.mat"

    print(INPUT_FILES)
    
    timetags_to_mat(INPUT_FILES, OUTPUT_FILE)